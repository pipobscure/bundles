#         uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
#         with:
#           node-version: ${{ vars.BUNDLE_NODE_VERSION }}
#           registry-url: https://registry.npmjs.org
#
#       - name: Install dependencies
#         run: npm ci
#
#       # ---- 1. CI: nothing gets packaged that does not pass -------------------
#       - name: Build
#         run: npm run build
#
#       - name: Typecheck
#         run: npm run typecheck
#
#       - name: Test
#         run: node --no-warnings --experimental-vfs --test test/*.test.ts
#
#       # ---- 2. the unsigned bundle -------------------------------------------
#       - name: Manifest — observe what the CLI reads, and close over it
#         run: npm run manifest:cli
#
#       - name: Pack — the unsigned bundle
#         run: npm run pack:cli
#
#       # ---- 3. baseline, audit, gate -----------------------------------------
#       # The published release becomes the comparison basis. It is verified before
#       # it is used: a baseline that cannot be placed would make the diff lie by
#       # omission, since everything it already contained would read as unchanged.
#       #
#       # --allow-missing covers the first release, and any release published
#       # before the CLI shipped as a signed member. The audit then reviews
#       # everything, which is slower and no less correct.
#       - name: Baseline — the release that is already out there
#         run: |
#           npm run trust
#           node --no-warnings --experimental-vfs tools/baseline.ts \
#             --identity "https://github.com/${{ github.repository }}/.github/workflows/release.yml@${{ github.ref }}" \
#             --issuer "$RELEASE_ISSUER" \
#             --allow-missing
#
#       # Installed by the tool itself, into the directory Claude Code looks in —
#       # so there is one copy of the skill in the repository and CI uses the same
#       # one a contributor would.
#       - name: Install the audit skill
#         run: node --no-warnings dist/main.js skill
#
#       - name: Audit — review the difference before signing
#         uses: anthropics/claude-code-action@833fb0f8c9f6686b33d963a8bae0a94f4936ab2a # v1
