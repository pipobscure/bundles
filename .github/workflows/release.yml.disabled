## =============================================================================
## THIS WORKFLOW CANNOT RUN YET. It is here to be read, not to fire.
## =============================================================================
##
## Everything below depends on a node no released line carries yet: `node:vfs` and
## the ZIP support in `node:zlib` are released and `ZipProvider` is merged, but the
## `--vfs-mount` / `--vfs-load` loader is still an open pull request (see HISTORY.md,
## "What changed in node").
## There is no `node-version` GitHub Actions can install that would make this pass,
## so shipping it live would produce a permanently red workflow and a repository
## that looks broken.
##
## It is disabled two ways over, deliberately:
##
##   * the file does not end in `.yml`/`.yaml`, so GitHub never parses it and no
##     "invalid workflow" annotation appears; and
##   * the workflow itself is commented out.
##
## Lines in this header begin with `##`; the workflow below begins with `# `. To
## enable it once the node work lands:
##
##     grep -v '^##' .github/workflows/release.yml.disabled \
##       | sed 's/^# \?//' > .github/workflows/release.yml
##     git rm .github/workflows/release.yml.disabled
##
## and set the repository variable BUNDLE_NODE_VERSION plus the ANTHROPIC_API_KEY
## and NPM_TOKEN secrets. The uncommented body is valid YAML exactly as it stands.
##
## What this is a record of: the release pipeline this project argues for, applied
## to itself — observe, create, audit against the last release, sign, publish —
## with the audit as a gate rather than a suggestion, and every action pinned by
## commit SHA. See HISTORY.md, "Implementation notes" §5.
## -----------------------------------------------------------------------------
##
# name: Release
#
# # Publishing a release, as the four steps this project says a bundle is built in
# # — with the audit as a real gate, and reviewed as a diff against the release
# # that is already out there rather than from scratch every time.
# #
# #   1. CI            everything must pass before anything is packaged
# #   2. create        the unsigned CLI bundle
# #   3. baseline      fetch the currently published bundle, and verify it
# #      audit         review the new one *against* it; a JSON verdict, pinned to bytes
# #      gate          refuse to go on without a clean verdict over exactly those bytes
# #   4. sign          sigstore, with this workflow's own OIDC identity
# #      publish       npm, with provenance from the same identity
# #
# # Every action is pinned to a full commit SHA rather than a tag. A tag is a
# # mutable pointer: whoever can move `v1` can change what runs inside a job that
# # holds an OIDC token able to sign releases. That is the supply-chain attack this
# # whole project is about, so the workflow that publishes it should not be
# # vulnerable to it. Update the SHAs deliberately, and read the diff when you do.
#
# on:
#   workflow_dispatch:
#     inputs:
#       publish:
#         description: Publish to npm after the gate passes
#         type: boolean
#         default: false
#   push:
#     tags: ['v*']
#
# permissions:
#   contents: read
#
# concurrency:
#   group: release
#   cancel-in-progress: false
#
# env:
#   # The identity a release carries, and the one a consumer pins. Both the
#   # baseline check and the post-sign verification use it.
#   RELEASE_ISSUER: https://token.actions.githubusercontent.com
#
# jobs:
#   release:
#     runs-on: ubuntu-latest
#     timeout-minutes: 60
#     permissions:
#       contents: read
#       # Fulcio takes the signing identity from this token, and npm takes its
#       # provenance attestation from the same one. Without it there is nothing to
#       # sign as, and no provenance to publish.
#       id-token: write
#     steps:
#       - name: Check out
#         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
#         with:
#           persist-credentials: false
#
#       # The archive format needs node:vfs and the --vfs-mount / --vfs-load loader,
#       # so a released node will not do until that work lands upstream. This is the one
#       # thing standing between this workflow and being able to run at all.
