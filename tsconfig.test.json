{
  // The same settings over the tests, the build tools and the examples, which live
  // outside `rootDir` and are never emitted — `npm run typecheck` is what holds them to
  // the same bar. The examples are checked here rather than built: they run from source
  // under node's type stripping, exactly as the test suite does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "tools/**/*.ts", "examples/**/*.ts"]
}
