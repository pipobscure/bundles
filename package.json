{
  "name": "@pipobscure/bundle",
  "version": "0.0.0",
  "description": "Record what an application reads, archive it, sign it with sigstore, verify it, and mount it as a verifying node:vfs provider so only signed archives run.",
  "keywords": [
    "SEA",
    "VFS",
    "signing",
    "sigstore",
    "bundle",
    "zip",
    "provenance"
  ],
  "license": "EUPL-1.2",
  "author": "Philipp Dunkel <pip@pipobscure.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipobscure/bundles.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/main.js",
  "bin": {
    "bundle": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./provider": "./dist/provider.js",
    "./register": "./dist/register.js",
    "./recorder": "./dist/recorder.js",
    "./record": "./dist/record.js",
    "./sea": "./dist/sea.js",
    "./manifest": "./dist/manifest.js",
    "./archive": "./dist/archive.js",
    "./skill": "./dist/skill.js",
    "./files": "./dist/files.js",
    "./sigstore": "./dist/sigstore.js",
    "./oidc": "./dist/oidc.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "skills/",
    "bundle.bundle",
    "shell-base",
    "README.md",
    "docs/"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/main.js dist/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck && node --no-warnings --experimental-vfs --test test/*.test.ts",
    "manifest:cli": "node --no-warnings --experimental-vfs tools/manifest.ts",
    "pack:cli": "node --no-warnings dist/main.js create --base . --files build/cli.manifest --output build/cli.bundle",
    "sign:cli": "node --no-warnings dist/main.js sign --output bundle.bundle build/cli.bundle",
    "sign:cli:local": "node --no-warnings dist/main.js sign --key certs/leaf.key --chain certs/chain.pem --output bundle.bundle build/cli.bundle",
    "verify:cli": "node --no-warnings dist/main.js verify bundle.bundle",
    "release:cli": "npm run build && npm run manifest:cli && npm run pack:cli",
    "trust": "node --no-warnings dist/main.js trust",
    "prepublishOnly": "node --no-warnings --experimental-vfs tools/prepublish.ts"
  },
  "dependencies": {
    "@sigstore/bundle": "^3.1.0",
    "@sigstore/protobuf-specs": "^0.4.3",
    "@sigstore/sign": "^3.1.0",
    "@sigstore/tuf": "^3.1.1",
    "@sigstore/verify": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
